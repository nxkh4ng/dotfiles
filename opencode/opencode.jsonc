{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "formatter": true,
  "lsp": true,
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"],
  },
  "permission": {
    "external_directory": "ask",
    "doom_loop": "ask",
    "question": "ask",
    "edit": "ask",
    "skill": "ask",
    "bash": {
      "*": "ask",
      "git log *": "allow",
      "git diff *": "allow",
      "git status *": "allow",
      "grep *": "allow",
      "ls *": "allow",
    },
    "todowrite": "allow",
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      ".env.example": "allow",
    },
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "lsp": "allow",
    "webfetch": "allow",
    "websearch": "allow",
  },
}
